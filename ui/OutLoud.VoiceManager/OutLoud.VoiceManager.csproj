<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\ProductVersion.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OutLoud.ico</ApplicationIcon>
    <NativeBuildDirectory Condition="'$(NativeBuildDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\build</NativeBuildDirectory>
    <NativeBridgePath>$(NativeBuildDirectory)\$(Configuration)\OutLoudVoiceManagerNative.dll</NativeBridgePath>
    <MutationHelperPath>$(NativeBuildDirectory)\$(Configuration)\OutLoudVoiceImportHelper.exe</MutationHelperPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\OutLoud.ico" />
    <Resource Include="Assets\OutLoud.ico" />
    <None Include="$(MutationHelperPath)" Link="OutLoudVoiceImportHelper.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NativeBridgePath)" Link="OutLoudVoiceManagerNative.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeBridge" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MutationHelperPath)')" Text="Build native target OutLoudVoiceImportHelper before building the WPF frontend." />
    <Error Condition="!Exists('$(NativeBridgePath)')"
           Text="Build the native x64 bridge first: cmake --build build --config $(Configuration) --target OutLoudVoiceManagerNative. For another CMake build directory, set -p:NativeBuildDirectory=absolute-path." />
  </Target>
  <Import Project="..\SapiIdentity.targets" />
</Project>
