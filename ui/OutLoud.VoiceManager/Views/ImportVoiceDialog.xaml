<Window x:Class="OutLoud.VoiceManager.Views.ImportVoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Voice" Width="530" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="26">
    <TextBlock Text="Import a voice" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14" />
    <TextBlock Text="Selected file" Style="{StaticResource Caption}" />
    <TextBox Text="{Binding SourcePath, Mode=OneWay}" Style="{StaticResource DetailValue}" Margin="0,6,0,16" MaxHeight="90" />
    <TextBlock Text="{Binding SourceFormat}" Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap" />
    <Label Content="Voice _name" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,6" />
    <TextBox x:Name="NameInput" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
             TextChanged="NameChanged" Padding="10,8" BorderThickness="1"
             BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
             SelectionBrush="{DynamicResource AccentBrush}" />
    <TextBlock Text="The file will be validated and installed in the managed Voice Library. Supported Pocket voice structure and integrity are checked before import."
               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,18" />
    <Border Style="{StaticResource Card}" Padding="14">
      <TextBlock Text="Out Loud needs Administrator permission to add this voice to the machine voice library and Windows speech system. Windows will ask after you click Import."
                 TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="_Cancel" IsCancel="True" Style="{StaticResource RefreshButton}" Margin="0,0,10,0" />
      <Button x:Name="ConfirmButton" Content="_Import" IsDefault="True" Style="{StaticResource RefreshButton}" Click="Confirm" />
    </StackPanel>
  </StackPanel>
</Window>
