<UserControl x:Class="OutLoud.VoiceManager.Views.VoiceTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
  <Grid Margin="28,24,28,18">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MinHeight="450" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Voice Tester" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{Binding BackendName}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
    </StackPanel>
    <Border x:Name="TestNotification" Grid.Row="1" Style="{StaticResource Notification}" Tag="{Binding Severity}" Padding="14" Margin="0,0,0,14" Visibility="{Binding HasNotification, Converter={StaticResource VisibleWhenTrue}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" FontSize="11" />
          <TextBlock x:Name="TestMessage" Text="{Binding NotificationText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <Expander Header="Diagnostic details" MaxHeight="130" Visibility="{Binding HasDiagnostic, Converter={StaticResource VisibleWhenTrue}}" Margin="0,6,0,0">
            <TextBox Text="{Binding Diagnostic, Mode=OneWay}" Style="{StaticResource DetailValue}" Margin="0,8,0,0" />
          </Expander>
        </StackPanel>
        <Button Grid.Column="1" Content="&#x00D7;" Command="{Binding DismissCommand}" Style="{StaticResource NotificationDismiss}" Foreground="{Binding Foreground, ElementName=TestMessage}" VerticalAlignment="Top" ToolTip="Dismiss notification" AutomationProperties.Name="Dismiss test notification" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Label Content="_Voice" Target="{Binding ElementName=TestVoiceSelector}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8" />
        <ComboBox x:Name="TestVoiceSelector" Grid.Row="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice, Mode=TwoWay}" MinHeight="40" Style="{StaticResource TesterComboBox}" AutomationProperties.Name="Managed Out Loud voice">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" />
            <TextBlock FontSize="11"><Run Text="{Binding LibraryId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Health, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SapiStatusText, Mode=OneWay}" /></TextBlock>
          </StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Label Grid.Row="2" Content="_English text" Target="{Binding ElementName=TestTextEditor}" Foreground="{DynamicResource TextBrush}" Padding="0,18,0,8" />
        <TextBox x:Name="TestTextEditor" Grid.Row="3" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="90" Style="{StaticResource TesterTextEditor}" AutomationProperties.Name="English text for the selected voice" />
        <Grid Grid.Row="4" Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ValidationText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,14,0" />
          <TextBlock Grid.Column="1" Text="{Binding CharacterCount}" Style="{StaticResource Caption}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="TestPlayButton" Content="_Play" Command="{Binding PlayCommand}" Style="{StaticResource RefreshButton}" Margin="0,0,10,0" />
        <Button x:Name="TestStopButton" Content="_Stop" Command="{Binding StopCommand}" Style="{StaticResource DestructiveButton}" Margin="0,0,10,0" />
        <Button Content="_Export WAV…" Command="{Binding ExportCommand}" Style="{StaticResource NavigationButton}" ToolTip="Generate a new WAV with this voice and current text; this does not capture previous playback" />
      </StackPanel>
      <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceMutedBrush}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" />
      <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
