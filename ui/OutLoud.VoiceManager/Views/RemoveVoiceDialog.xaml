<Window x:Class="OutLoud.VoiceManager.Views.RemoveVoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Voice" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="26">
    <TextBlock Text="{Binding Prompt}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
    <TextBlock Text="This will remove the voice from Out Loud and Windows speech. This action cannot be undone."
               TextWrapping="Wrap" Margin="0,0,0,16" />
    <Border Style="{StaticResource Card}" Padding="14">
      <StackPanel>
        <TextBlock Text="Library ID" Style="{StaticResource Caption}" />
        <TextBlock Text="{Binding Target.LibraryId}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,12" />
        <TextBlock Text="Administrator approval is requested after confirmation. Close WoW or other active speech consumers before removing a loaded voice."
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="CancelRemoveButton" Content="_Cancel" IsCancel="True" IsDefault="True" Style="{StaticResource RefreshButton}" Margin="0,0,10,0" />
      <Button x:Name="ConfirmRemoveButton" Content="_Remove" Style="{StaticResource DestructiveButton}" Click="Confirm" />
    </StackPanel>
  </StackPanel>
</Window>
