<Window x:Class="OutLoud.VoiceManager.Views.ReplaceVoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace Voice" Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="26">
    <TextBlock Text="Replace existing voice data?" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14" />
    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,0,0,14" />
    <TextBlock Text="Choose the exact target. If several voices share this name, select its immutable ID explicitly."
               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ListBox x:Name="Targets" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
             SelectionMode="Single" SelectionChanged="TargetChanged" MaxHeight="180"
             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{DynamicResource SurfaceBrush}"><ContentPresenter /></Border>
          <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
          </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding LibraryId}" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" />
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Style="{StaticResource Card}" Padding="14" Margin="0,16,0,0">
      <TextBlock Text="The existing name, voice identity and Windows speech registration will be preserved. Administrator approval is required. Close WoW or other active consumers before replacing a loaded voice."
                 TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="_Cancel" IsCancel="True" Style="{StaticResource RefreshButton}" Margin="0,0,10,0" />
      <Button x:Name="ReplaceButton" Content="_Replace" IsDefault="True" Style="{StaticResource RefreshButton}" Click="Confirm" />
    </StackPanel>
  </StackPanel>
</Window>
