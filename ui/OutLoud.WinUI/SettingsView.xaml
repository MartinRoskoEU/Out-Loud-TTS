<UserControl x:Class="OutLoud.WinUI.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:OutLoud.WinUI">
    <!-- Runtime and model management use Out Loud's private stores. -->
    <Grid x:Name="ModelSetupPanel">
        <Grid.Resources>
            <local:ModelInstallationGlyphConverter x:Key="ModelInstallationGlyph" />
            <local:ModelInstallationStatusConverter x:Key="ModelInstallationStatus" />
            <Style x:Key="NotificationPanelStyle" TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="NotificationTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="NotificationSuccessTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="NotificationErrorTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="NotificationWarningTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="NotificationInformationTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="NotificationDismissButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="RuntimeNeutralTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="RuntimeSuccessTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="RuntimeAccentTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="RuntimeWarningTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="RuntimeIndicatorStyle" TargetType="local:RuntimeStatusIndicator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:RuntimeStatusIndicator">
                            <Ellipse Fill="{TemplateBinding Foreground}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RuntimeNeutralIndicatorStyle" TargetType="local:RuntimeStatusIndicator" BasedOn="{StaticResource RuntimeIndicatorStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="RuntimeSuccessIndicatorStyle" TargetType="local:RuntimeStatusIndicator" BasedOn="{StaticResource RuntimeIndicatorStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="RuntimeErrorIndicatorStyle" TargetType="local:RuntimeStatusIndicator" BasedOn="{StaticResource RuntimeIndicatorStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </Grid.Resources>
        <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="20">
                <Grid x:Name="SettingsHeader" ColumnSpacing="16" SizeChanged="SettingsHeader_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="SettingsHeaderText" Spacing="8">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Manage the Pocket TTS runtime and voice models." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="UpdateCheckActions" Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressRing x:Name="UpdateChecksProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" IsTabStop="False" AutomationProperties.Name="Checking for updates" />
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates" IsEnabled="False" Click="CheckUpdates_Click" Height="36" Padding="16,0" FontSize="14" ToolTipService.ToolTip="Check the Pocket TTS runtime and installed models for updates. Updates require separate confirmation." />
                    </StackPanel>
                </Grid>
                <Border Padding="20" CornerRadius="8" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="RuntimeRow" RowSpacing="4" ColumnSpacing="16" SizeChanged="RuntimeRow_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Pocket TTS Runtime" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeVersionText" Grid.Row="1" Text="Checking installed release…" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <local:RuntimeStatusIndicator x:Name="RuntimeReadinessIndicator" Grid.Column="1" Grid.RowSpan="2" Width="12" Height="12" Margin="0,0,12,0" Style="{StaticResource RuntimeNeutralIndicatorStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsTabStop="False" ToolTipService.ToolTip="Runtime status unknown" AutomationProperties.Name="Runtime status unknown" AutomationProperties.AccessibilityView="Content" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <Border Grid.Row="1" Height="1" Margin="0,16,0,16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid x:Name="RuntimeUpdateRow" Grid.Row="2" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="RuntimeUpdateStatusPanel" ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing x:Name="RuntimeUpdateProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                <FontIcon x:Name="RuntimeUpdateIcon" FontSize="18" Visibility="Collapsed" Foreground="{Binding Foreground, ElementName=RuntimeUpdateStatusText}" IsHitTestVisible="False" />
                                <TextBlock x:Name="RuntimeUpdateStatusText" Grid.Column="1" Text="Checking for updates..." FontSize="16" FontWeight="SemiBold" Style="{StaticResource RuntimeNeutralTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Runtime update status" AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                            <StackPanel x:Name="RuntimeUpdateActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button IsEnabled="False" x:Name="RuntimeUpdateButton" Content="Update" Visibility="Collapsed" Height="36" Padding="16,0" FontSize="14" Click="RuntimeUpdateButton_Click" />
                                <Button x:Name="RuntimeCancelUpdateButton" Content="Cancel" Visibility="Collapsed" Height="36" Padding="16,0" FontSize="14" Click="RuntimeCancelUpdateButton_Click" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="RuntimeInstallProgressBar" Grid.Row="3" Margin="0,12,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" IsIndeterminate="True" AutomationProperties.Name="Runtime installation progress" />
                        <TextBlock x:Name="ModelSetupStatusText" Grid.Row="4" Margin="0,12,0,0" Text="Checking runtime and installed models…" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Border>
                <Border x:Name="ModelInstallationPanel" Style="{StaticResource NotificationPanelStyle}" Visibility="Collapsed">
                    <Border.Resources>
                        <Style x:Key="InstallationTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource NotificationTitleStyle}" />
                        <Style x:Key="InstallationSuccessTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource NotificationSuccessTitleStyle}" />
                        <Style x:Key="InstallationErrorTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource NotificationErrorTitleStyle}" />
                        <Style x:Key="InstallationNeutralTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource NotificationInformationTitleStyle}" />
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ModelInstallationHeading" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="ModelInstallationResultIcon" FontSize="20" Visibility="Collapsed" Foreground="{Binding Foreground, ElementName=ModelInstallationTitleText}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ModelInstallationTitleText" Grid.Column="1" Text="Installing model" FontSize="17" FontWeight="SemiBold" Style="{StaticResource InstallationTitleStyle}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <Button Click="DismissModelInstallation_Click" x:Name="DismissModelInstallationButton" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource NotificationDismissButtonStyle}" Visibility="Collapsed" ToolTipService.ToolTip="Dismiss installation notification" AutomationProperties.Name="Dismiss installation notification">
                            <FontIcon Glyph="" FontSize="14" />
                        </Button>
                        <StackPanel Grid.Row="1" Margin="0,4,0,0" Spacing="8">
                            <TextBlock x:Name="ModelInstallationModelText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ModelInstallationStatusText" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <ProgressBar x:Name="ModelInstallationProgress" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Model installation progress" />
                        <Button Click="CancelModelInstallation_Click" x:Name="CancelModelInstallationButton" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Height="36" Padding="16,0" FontSize="14" Content="Cancel installation" HorizontalAlignment="Right" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="ModelsCard" Padding="20" CornerRadius="8" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="ModelIncompatibleForegroundBrush" Color="#FFB366" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ModelIncompatibleForegroundBrush" Color="#9D4D00" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="ModelIncompatibleForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <local:ModelManagementActionConverter x:Key="ModelManagementAction" />
                            <local:ModelUpdateVisibilityConverter x:Key="ModelUpdateVisibility" />
                            <Style x:Key="ModelInstalledStatusStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Style>
                            <Style x:Key="ModelNotInstalledStatusStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Style>
                            <Style x:Key="ModelUnverifiedStatusStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                            </Style>
                            <Style x:Key="ModelIncompatibleStatusStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource ModelIncompatibleForegroundBrush}" />
                            </Style>
                            <local:ModelInstallationStyleConverter x:Key="ModelStatusStyle"
                                Installed="{StaticResource ModelInstalledStatusStyle}" NotInstalled="{StaticResource ModelNotInstalledStatusStyle}"
                                Unverified="{StaticResource ModelUnverifiedStatusStyle}" Incompatible="{StaticResource ModelIncompatibleStatusStyle}" />
                        </ResourceDictionary>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ModelsHeaderText" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Models" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Manage installed and supported voice models." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ModelUpdatesStatusText" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <ComboBox x:Name="SelectedModelComboBox" Grid.Row="1" Margin="0,16,0,0" Header="Selected model"
                                  PlaceholderText="Select an installed model" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                  SelectionChanged="SelectedModel_SelectionChanged" />
                        <ContentControl x:Name="ModelListHost" Grid.Row="2" Margin="0,16,0,0" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                            <ItemsRepeater x:Name="ModelList" Visibility="Collapsed">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="64" Padding="0,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center" SizeChanged="ModelRow_SizeChanged">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" x:Name="ModelIdentifierText" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Grid x:Name="ModelRowStatus" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding State, Converter={StaticResource ModelInstallationGlyph}}" FontSize="14" Foreground="{Binding Foreground, ElementName=ModelRowStatusText}" />
                                                    <TextBlock Text="{Binding State, Converter={StaticResource ModelInstallationStatus}}" Style="{Binding State, Converter={StaticResource ModelStatusStyle}}" x:Name="ModelRowStatusText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="12" MaxWidth="180" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding UpdateStatusText, Converter={StaticResource ModelUpdateVisibility}}" AutomationProperties.LiveSetting="Polite" />
                                                </Grid>
                                                <StackPanel x:Name="ModelRowAction" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button IsEnabled="{Binding CanUpdate}" Content="Update" Visibility="{Binding UpdateCommit, Converter={StaticResource ModelUpdateVisibility}}" Click="UpdateModel_Click" MinWidth="88" Height="32" Padding="12,0" FontSize="13" />
                                                    <Button IsEnabled="{Binding CanManage}" Content="{Binding Converter={StaticResource ModelManagementAction}}" Visibility="{Binding Converter={StaticResource ModelManagementAction}, ConverterParameter=Visibility}" Click="ManageModel_Click" MinWidth="88" Height="32" Padding="12,0" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ContentControl>
                        <TextBlock x:Name="ModelListEmptyText" Grid.Row="3" Margin="0,16,0,0" Text="Refreshing models..." FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
