<Window
    x:Class="OutLoud.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OutLoud.WinUI"
    Title="Out Loud">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="138" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Out Loud" Margin="16,0,0,0" FontFamily="Segoe UI Variable"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <NavigationView x:Name="ShellNavigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" IsPaneToggleButtonVisible="False" OpenPaneLength="208" CompactPaneLength="48"
                        FontFamily="Segoe UI Variable" FontSize="14" IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Margin" Value="4,0,4,4" />
                    </Style>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="VoiceLibraryNavigationItem" Content="Voice Library" Icon="Library" />
                <NavigationViewItem x:Name="VoiceTesterNavigationItem" Content="Voice Tester" Icon="Microphone" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Grid>
                <local:VoiceLibraryView x:Name="VoiceLibraryPageHost" Visibility="Collapsed" />
                <local:VoiceTesterView x:Name="VoiceTesterPageHost" Visibility="Collapsed" />
                <local:SettingsView x:Name="SettingsPageHost" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
