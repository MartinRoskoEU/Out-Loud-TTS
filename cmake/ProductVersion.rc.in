#include <winver.h>
1 VERSIONINFO
 FILEVERSION @OUTLOUD_VERSION_TUPLE@
 PRODUCTVERSION @OUTLOUD_VERSION_TUPLE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @OUTLOUD_FILE_TYPE@
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Nendis\0"
      VALUE "FileDescription", "@OUTLOUD_FILE_DESCRIPTION@\0"
      VALUE "FileVersion", "@OUTLOUD_WINDOWS_VERSION@\0"
      VALUE "InternalName", "@OUTLOUD_ORIGINAL_FILENAME@\0"
      VALUE "LegalCopyright", "@OUTLOUD_PRODUCT_COPYRIGHT@\0"
      VALUE "OriginalFilename", "@OUTLOUD_ORIGINAL_FILENAME@\0"
      VALUE "ProductName", "@OUTLOUD_PRODUCT_NAME@\0"
      VALUE "ProductVersion", "@OUTLOUD_PRODUCT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
