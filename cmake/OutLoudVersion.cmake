include_guard(GLOBAL)
function(outloud_read_product_version source)
    file(READ "${source}" metadata)
    foreach(field ProductVersion ProductName ProductCopyright)
        string(REGEX MATCHALL "<OutLoud${field}>[^<]*</OutLoud${field}>" matches "${metadata}")
        list(LENGTH matches count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "ProductVersion.props requires one OutLoud${field}.")
        endif()
        string(REGEX REPLACE "<OutLoud${field}>([^<]*)</OutLoud${field}>" "\\1" value "${matches}")
        set("OUTLOUD_${field}" "${value}")
    endforeach()
    if(NOT OUTLOUD_ProductVersion MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
        message(FATAL_ERROR "Out Loud requires canonical MAJOR.MINOR.PATCH versioning.")
    endif()
    string(REPLACE "." ";" parts "${OUTLOUD_ProductVersion}")
    foreach(part IN LISTS parts)
        string(LENGTH "${part}" length)
        if(length GREATER 5 OR part GREATER 65534)
            message(FATAL_ERROR "Out Loud version components must fit Windows and .NET assembly metadata (0..65534).")
        endif()
    endforeach()
    if(NOT OUTLOUD_ProductName STREQUAL "Out Loud" OR NOT OUTLOUD_ProductCopyright STREQUAL "Copyright (c) 2026 Nendis")
        message(FATAL_ERROR "Unexpected Out Loud product identity/copyright.")
    endif()
    set(OUTLOUD_PRODUCT_VERSION "${OUTLOUD_ProductVersion}" PARENT_SCOPE)
    set(OUTLOUD_WINDOWS_VERSION "${OUTLOUD_ProductVersion}.0" PARENT_SCOPE)
    string(REPLACE "." "," tuple "${OUTLOUD_ProductVersion}.0")
    set(OUTLOUD_VERSION_TUPLE "${tuple}" PARENT_SCOPE)
    set(OUTLOUD_PRODUCT_NAME "${OUTLOUD_ProductName}" PARENT_SCOPE)
    set(OUTLOUD_PRODUCT_COPYRIGHT "${OUTLOUD_ProductCopyright}" PARENT_SCOPE)
endfunction()

function(outloud_add_version_resource target description)
    get_target_property(kind "${target}" TYPE)
    if(kind STREQUAL "SHARED_LIBRARY")
        set(OUTLOUD_FILE_TYPE VFT_DLL)
        set(OUTLOUD_ORIGINAL_FILENAME "${target}.dll")
    elseif(kind STREQUAL "EXECUTABLE")
        set(OUTLOUD_FILE_TYPE VFT_APP)
        set(OUTLOUD_ORIGINAL_FILENAME "${target}.exe")
    else()
        message(FATAL_ERROR "Version resources require a DLL or executable.")
    endif()
    set(OUTLOUD_FILE_DESCRIPTION "${description}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ProductVersion.rc.in"
        "${CMAKE_CURRENT_BINARY_DIR}/versions/${target}.rc" @ONLY)
    target_sources("${target}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/versions/${target}.rc")
endfunction()
