# The SAPI resolver uses the same pinned runtime metadata as WinUI. No model
# catalog, network lookup, or caller-provided YAML enters the native trust boundary.
set(rust_metadata_root "${CMAKE_CURRENT_SOURCE_DIR}/ui/OutLoud.WinUI/RuntimeMetadata/v4.0.1")
file(GLOB rust_configs CONFIGURE_DEPENDS "${rust_metadata_root}/configs/*.yaml")
file(GLOB rust_repositories CONFIGURE_DEPENDS "${rust_metadata_root}/repositories/*.json")
set(rust_metadata "// Generated from OutLoud.WinUI RuntimeMetadata; do not edit.\n")
set(rust_references "")
foreach(source IN LISTS rust_configs)
    file(READ "${source}" contents)
    string(REGEX MATCHALL "hf://kyutai/pocket-tts-without-voice-cloning/[^ \t\r\n@]+@[a-f0-9]+" references "${contents}")
    list(APPEND rust_references ${references})
endforeach()
list(REMOVE_DUPLICATES rust_references)
foreach(kind IN ITEMS configs repositories)
    string(APPEND rust_metadata "inline constexpr Metadata ${kind}[] = {\n")
    foreach(source IN LISTS rust_${kind})
        file(READ "${source}" contents)
        get_filename_component(name "${source}" NAME_WE)
        if(kind STREQUAL "repositories")
            # Embed only the files actually referenced by the official configs,
            # not the repository's unrelated voice catalog/large API response.
            string(JSON revision GET "${contents}" sha)
            string(JSON repo GET "${contents}" id)
            string(JSON count LENGTH "${contents}" siblings)
            set(filtered "{\"id\":\"${repo}\",\"sha\":\"${revision}\",\"siblings\":[")
            set(separator "")
            math(EXPR last "${count}-1")
            foreach(i RANGE 0 ${last})
                string(JSON path GET "${contents}" siblings ${i} rfilename)
                set(reference "hf://${repo}/${path}@${revision}")
                if(reference IN_LIST rust_references)
                    string(JSON entry GET "${contents}" siblings ${i})
                    string(APPEND filtered "${separator}${entry}")
                    set(separator ",")
                endif()
            endforeach()
            string(APPEND filtered "]}")
            set(contents "${filtered}")
        endif()
        # MSVC bounds individual string tokens; adjacent chunks preserve bytes.
        string(APPEND rust_metadata "{\"${name}\",")
        string(LENGTH "${contents}" length)
        set(offset 0)
        while(offset LESS length)
            string(SUBSTRING "${contents}" ${offset} 8000 chunk)
            string(APPEND rust_metadata "R\"outloud(${chunk})outloud\"\n")
            math(EXPR offset "${offset}+8000")
        endwhile()
        string(APPEND rust_metadata "},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    endforeach()
    string(APPEND rust_metadata "};\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/rust_model_metadata.hpp" CONTENT "${rust_metadata}")
